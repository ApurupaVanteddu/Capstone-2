# IncidentIQ Configuration
INCIDENT_DATA_PATH=./data/processed/cleaned_incidents.csv
DB_PATH=./data/incidentiq.db
TOP_K_DEFAULT=5

# Security & JWT
JWT_SECRET=incidentiq-super-secret-key-2026-secure-token

# LLM Providers (OpenRouter, Gemini, OpenAI, NVIDIA)
# OpenRouter API Key (Supports OPENROUTER_API_KEY or OPENROUTE_API_KEY)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# NVIDIA API
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
